# Copy to .env.local (gitignored) and fill in. Only VITE_ variables reach the browser, so
# never put a secret or service-role key here.

# Supabase project URL. Local stack: http://127.0.0.1:54321 (see `npx supabase status`).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (the public "anon" key). Local stack: printed by `npx supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Path the site is served from, e.g. /budget/ when deployed in a subfolder. Default: /
VITE_BASE_PATH=/
