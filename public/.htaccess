# Apache configuration for the static build (dist/) on Infomaniak web hosting.
#
# Works at the domain root or in a subfolder without edits: build with VITE_BASE_PATH set to
# the subfolder and the rules below work out the base path themselves.
# Every module-specific block is wrapped in <IfModule> so a missing module never turns the
# site into a 500 error; the site then just loses that feature.

# ---------------------------------------------------------------------------
# SPA fallback: any URL that is not an existing file or directory serves index.html,
# so React Router can handle it (deep links, reloads, links from auth emails).
# ---------------------------------------------------------------------------
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Work out the URL path of the folder holding this file, without hard-coding it:
  # for /budget/settings in a site under /budget/, BASE becomes "/budget"; at the domain
  # root it stays empty.
  RewriteCond %{REQUEST_URI}::$1 ^(/.+)/(.*)::\2$
  RewriteRule ^(.*) - [E=BASE:%1]

  # Missing build assets are a real 404, never index.html: serving HTML in place of a
  # script would hide the error behind a MIME type failure.
  RewriteRule ^assets/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ %{ENV:BASE}/index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# MIME types the server may not know
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .js .mjs .json .svg .webmanifest .txt
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#   assets/*  Vite puts a content hash in every file name there: cache for a year.
#   *.html    Always revalidate, so a new deploy is picked up on the next load.
#   others    (favicon and other files copied from public/) one hour.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=3600"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>

  <If "%{REQUEST_URI} =~ m#/assets/[^/]+$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
#
# Content-Security-Policy: the app loads only its own files and talks to Supabase over
# https (REST, Auth) and wss (Realtime). connect-src allows any *.supabase.co project;
# docs/deployment.md explains how to narrow it to this project's URL.
# style-src needs 'unsafe-inline' for the style attributes set by UI components.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Only sent over HTTPS. Enable "force HTTPS" for the site in the Infomaniak Manager.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
